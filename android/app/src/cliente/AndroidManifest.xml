<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <!-- La app del cliente no comparte ubicación en segundo plano (solo el conductor):
         sin esto Play exige la declaración y el video de ubicación en segundo plano. -->
    <uses-permission android:name="android.permission.ACCESS_BACKGROUND_LOCATION" tools:node="remove" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_LOCATION" tools:node="remove" />
    <application>
        <service
            android:name="id.flutter.flutter_background_service.BackgroundService"
            tools:node="remove" />
    </application>
</manifest>
